{
  "name": "near-bouncer",
  "version": "0.1.0",
  "description": "Bouncer \u2014 testnet multi-resource procurement with on-chain spending policies (unaudited prototype)",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test packages/policy/policy.test.mjs tests/*.test.mjs",
    "test:all": "node --test packages/policy/policy.test.mjs tests/*.test.mjs",
    "build": "bash scripts/build.sh",
    "agent": "node agent/procurement.mjs",
    "solver": "node agent/solver.mjs",
    "quote": "node agent/intents.mjs quote",
    "market": "node agent/intents.mjs market",
    "demo": "node demo-multi-resource.mjs",
    "simulation": "echo \"Offline simulation only: open demo/index.html; no transactions are sent.\""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdullahimujeeb0505-stack/Bouncer"
  },
  "dependencies": {
    "near-api-js": "6.5.1"
  }
}
