{
  "name": "near-bouncer",
  "version": "0.1.0",
  "description": "Bouncer — testnet multi-resource procurement with on-chain spending policies (unaudited prototype)",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test packages/policy/policy.test.mjs tests/*.test.mjs",
    "test:all": "node --test packages/policy/policy.test.mjs tests/*.test.mjs",
    "test:svalin-upstream": "node scripts/test-svalin-upstream.mjs",
    "build": "bash scripts/build.sh",
    "agent": "node agent/procurement.mjs",
    "recover-direct": "node agent/recover-direct-payment.mjs",
    "recover-direct-delivery": "node agent/recover-direct-delivery.mjs",
    "multiagency": "node agent/multiagency.mjs",
    "svalin-pro": "node agent/svalin-pro.mjs",
    "svalin-preflight": "node agent/svalin-pro-preflight.mjs",
    "svalin-setup-plan": "node agent/svalin-setup-plan.mjs",
    "svalin-setup-preflight": "node agent/svalin-setup-preflight.mjs",
    "recover-youtick-grant": "node agent/recover-youtick-grant.mjs",
    "encrypt-file-journal": "node scripts/encrypt-file-journal.mjs",
    "init-file-journal-key": "node scripts/init-file-journal-key.mjs",
    "init-shared-buyer-db": "node scripts/init-shared-buyer-db.mjs",
    "init-shared-buyer-journal": "node scripts/init-shared-buyer-journal.mjs",
    "activate-buyer-intents": "node scripts/activate-buyer-intents.mjs",
    "inspect-shared-buyer": "node scripts/inspect-shared-buyer.mjs",
    "rotate-shared-buyer-key": "node scripts/rotate-shared-buyer-key.mjs",
    "snapshot-shared-buyer": "node scripts/snapshot-shared-buyer.mjs",
    "onchain-proof": "node agent/onchain-proof.mjs",
    "inspect-x402": "node agent/inspect-x402.mjs",
    "shared-provider": "node services/shared-resource-provider.mjs",
    "init-shared-seller-db": "node scripts/init-shared-seller-db.mjs",
    "inspect-shared-seller": "node scripts/inspect-shared-seller.mjs",
    "outlayer": "node agent/outlayer.mjs",
    "oracle": "node agent/oracle-outlayer.mjs",
    "ft-call": "node agent/ft-call.mjs",
    "ref-swap": "node agent/ref-swap.mjs",
    "outlayer-project": "node agent/outlayer-project.mjs",
    "mission": "node agent/mixed-mission.mjs",
    "paid-mission": "node agent/paid-mission.mjs",
    "workflow": "node agent/workflow.mjs",
    "solver": "node agent/solver.mjs",
    "quote": "node agent/intents.mjs quote",
    "discover": "node agent/market-discovery.mjs",
    "market": "node agent/intents.mjs market",
    "demo": "node demo-multi-resource.mjs",
    "simulation": "echo \"Offline simulation only: open demo/index.html; no transactions are sent.\"",
    "build:web": "node scripts/build-web.mjs",
    "mcp": "node mcp/server.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Greatmujey/Bouncer"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.2.1",
    "near-api-js": "6.5.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wabt": "1.0.39"
  }
}
